TARGET = bin/back

SRC_DIR     = src
BUILD_DIR   = obj
INCLUDE_DIR = inc
COMMON_DIR  = ../Common
TREE_DIR    = Tree
FRONT_DIR   = ../Frontend

COMMON_SOURCES = $(COMMON_DIR)/$(TREE_DIR)/src/dump_funcs.cpp \
                 $(COMMON_DIR)/$(TREE_DIR)/src/tree_funcs.cpp \
                 $(COMMON_DIR)/hash_funcs.cpp \
                 $(COMMON_DIR)/write_tree_in_file_funcs.cpp \
                 $(COMMON_DIR)/read_from_file_funcs.cpp \
                 $(COMMON_DIR)/name_table_funcs.cpp

BACKEND_SOURCES = $(SRC_DIR)/backend_main.cpp \
                   $(SRC_DIR)/basewords_backend.cpp \
                   $(SRC_DIR)/parse_tree_from_buffer_funcs.cpp \
                   $(SRC_DIR)/parse_ast_tree_funcs.cpp \
                   $(SRC_DIR)/emitter_funcs.cpp \
                   $(SRC_DIR)/create_elf_file_funcs.cpp \

SOURCES_CXX = $(COMMON_SOURCES) $(BACKEND_SOURCES)

OBJECTS_CXX = $(addprefix $(BUILD_DIR)/, $(notdir $(SOURCES_CXX:.cpp=.o)))

CXX = g++

OPTIMIZATION = -O3 -march=native
DEBUG_FLAGS = -g

WARNING_FLAGS = -Wall -Wextra -Weffc++ \
                -Waggressive-loop-optimizations \
                -Wc++14-compat \
                -Wmissing-declarations \
                -Wcast-align \
                -Wcast-qual \
                -Wchar-subscripts \
                -Wconditionally-supported \
                -Wconversion \
                -Wctor-dtor-privacy \
                -Wempty-body \
                -Wfloat-equal \
                -Wformat-nonliteral \
                -Wformat-security \
                -Wformat-signedness \
                -Wformat=2 \
                -Winline \
                -Wlogical-op \
                -Wnon-virtual-dtor \
                -Wopenmp-simd \
                -Woverloaded-virtual \
                -Wpacked \
                -Wpointer-arith \
                -Winit-self \
                -Wredundant-decls \
                -Wshadow \
                -Wsign-conversion \
                -Wsign-promo \
                -Wstrict-null-sentinel \
                -Wstrict-overflow=2 \
                -Wsuggest-attribute=noreturn \
                -Wsuggest-final-methods \
                -Wsuggest-final-types \
                -Wsuggest-override \
                -Wswitch-default \
                -Wswitch-enum \
                -Wsync-nand \
                -Wundef \
                -Wunreachable-code \
                -Wuseless-cast \
                -Wvariadic-macros \
                -Wno-literal-suffix \
                -Wno-missing-field-initializers \
                -Wno-narrowing \
                -Wno-old-style-cast \
                -Wno-varargs \
                -Wstack-protector \
                -Wlarger-than=8192 \
                -Wstack-usage=8192 \
                -Werror=vla \
                -fcheck-new \
                -fsized-deallocation \
                -fstack-protector \
                -fstrict-overflow \
                -flto-odr-type-merging \
                -pie -fPIE

SANITIZER_FLAGS = -fsanitize=address,undefined -fno-omit-frame-pointer
CXX_STANDARD = -std=c++17

LDFLAGS = $(SANITIZER_FLAGS)

INCLUDES = -I$(INCLUDE_DIR) \
           -I$(COMMON_DIR) \
           -I$(COMMON_DIR)/$(TREE_DIR)/$(INCLUDE_DIR) \
           -I$(FRONT_DIR)/$(INCLUDE_DIR) \

CXXFLAGS = $(OPTIMIZATION) $(DEBUG_FLAGS) $(WARNING_FLAGS) $(SANITIZER_FLAGS) $(CXX_STANDARD) $(INCLUDES)

.PHONY: all clean

all: $(TARGET)

$(BUILD_DIR):
	mkdir -p $@

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: $(COMMON_DIR)/$(TREE_DIR)/src/%.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: $(COMMON_DIR)/%.cpp | $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(TARGET): $(OBJECTS_CXX)
	$(CXX) $(OBJECTS_CXX) -o $@ $(LDFLAGS)

clean:
	rm -rf $(TARGET) $(BUILD_DIR)